# Server-only AI configuration. Never expose these with NEXT_PUBLIC_ prefixes.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Public Solana configuration used by the browser application.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Add after the registry program has been deployed to Devnet.
NEXT_PUBLIC_FLUX_REGISTRY_PROGRAM_ID=
